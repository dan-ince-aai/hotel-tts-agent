# AssemblyAI: speech-to-text, LLM Gateway, and our TTS.
ASSEMBLYAI_API_KEY=

# The three competitors' TTS.
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
INWORLD_API_KEY=

# The study app the agent asks for each call's voice, and reports back to. The secret must
# match STUDY_AGENT_SECRET on the study app.
STUDY_API_URL=
STUDY_AGENT_SECRET=

# LiveKit: only for `dev` and `start` (LiveKit Cloud sets these for a deployed agent).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
