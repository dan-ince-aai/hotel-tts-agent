# The study web app's settings (server.ts). The LiveKit agent has its own list in
# agent/.env.example.
#
# Locally, put values in .env (git ignores it). On Render, set them on the service: the server
# reads only the names DECLARED here, so a value set in the dashboard reaches it because its
# name is listed below. Blank lines are fine.

# --- LiveKit: the audio for every call ---------------------------------------
#
# From your LiveKit Cloud project (Settings → API keys). The server mints each participant a
# token for a fresh room and dispatches the desk agent into it. Blank: calls are off.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- The agent's private API ---------------------------------------------------
#
# The desk agent asks /internal/calls/{token} which voice a call uses and reports what
# happened on it. Use a long random value, and set the same one as the agent's
# STUDY_AGENT_SECRET. Blank: the agent API is off.
STUDY_AGENT_SECRET=

# --- Before the clones are done (see voices.ts) --------------------------------
#
# The server refuses to start with any voice cell missing from study/voice-ids.json. For a
# REHEARSAL, set STUDY_OURS_STANDIN to a competitor (e.g. cartesia) to speak the "ours" column
# with its clones. For LOCAL DEVELOPMENT only, set STUDY_ALLOW_MISSING_VOICES=1 to fill empty
# cells with stock voices. Both mark every session rehearsal; leave both blank for real data.
STUDY_OURS_STANDIN=
STUDY_ALLOW_MISSING_VOICES=

# --- The results database --------------------------------------------------------
#
# Participants, sessions, calls, answers, transcripts and per-reply speed (study/store.ts).
# Blank: kept in memory instead, which is fine for development and lost on restart. On
# Render, the blueprint wires this to the managed database.
DATABASE_URL=

# --- The session schedule --------------------------------------------------------
#
# Seeds each participant's voice order and persona-card deal (study/design.ts). Leave it
# alone once real sessions exist: changing it reshuffles everyone's remaining sessions.
STUDY_SEED=

# --- The admin page and data export -----------------------------------------------
#
# /admin and the CSVs (/api/export/sessions.csv, /api/export/calls.csv) take
# STUDY_ADMIN_PASSWORD. The Render blueprint also generates STUDY_ADMIN_TOKEN, which works
# the same way. With neither set, the admin page and the export are off.
STUDY_ADMIN_PASSWORD=
STUDY_ADMIN_TOKEN=

# --- Voice cloning (scripts/clone_voices.py only) ----------------------------------
#
# The web app itself never calls a TTS; the agent does. These are read by the cloning script,
# and must belong to the same accounts as the agent's keys.
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
INWORLD_API_KEY=
